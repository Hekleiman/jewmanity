---
interface Props {
  id: string;
  name: string;
  price: string;
  priceNum: string;
  href: string;
  description: string;
  image: string;
  inStock?: boolean;
  stripePaymentLinkUrl?: string;
}

const { name, price, href, image, inStock = true, stripePaymentLinkUrl } = Astro.props;
const canPurchase = inStock && !!stripePaymentLinkUrl;
const unavailableLabel = inStock ? 'Coming Soon' : 'Sold Out';
const unavailableAria = inStock
  ? 'This product is not yet available for purchase'
  : 'This product is currently sold out';
---

<article class="overflow-hidden rounded-[24px] border-[0.5px] border-border-card bg-white shadow-[0px_16px_32px_rgba(12,12,13,0.1),0px_4px_4px_rgba(12,12,13,0.05)]">
  <a href={href} class="block">
    {image ? (
      <img src={image} alt={name} class="aspect-square w-full object-cover" width="600" height="600" loading="lazy" />
    ) : (
      <div class="aspect-square bg-gradient-to-br from-primary/10 to-primary/5"></div>
    )}
  </a>
  <div class="p-5">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-body text-lg font-medium text-text-heading">
        <a href={href} class="transition-colors hover:text-primary">{name}</a>
      </h3>
      <span class="shrink-0 font-heading text-lg font-medium text-primary">{price}</span>
    </div>
    {canPurchase ? (
      <a
        href={stripePaymentLinkUrl}
        class="mt-4 block w-full rounded-[100px] bg-primary py-3 text-center font-heading text-sm font-medium text-white transition-colors hover:bg-primary-hover"
      >
        Add to Cart +
      </a>
    ) : (
      <div
        class="mt-4 w-full rounded-[100px] bg-bg-section-alt py-3 text-center font-heading text-sm font-medium text-text-muted"
        aria-label={unavailableAria}
      >
        {unavailableLabel}
      </div>
    )}
  </div>
</article>
