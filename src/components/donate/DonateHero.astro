---
interface CtaButton {
  label: string;
  url: string;
  style?: 'primary' | 'secondary';
}

interface Props {
  imagePosition?: string;
  heading?: string;
  subtitle?: string;
  imageUrl?: string;
  taxNote?: string;
  ctas?: CtaButton[];
  givebutterAccountId?: string;
  givebutterWidgetId?: string;
}

const {
  imagePosition = 'center 25%',
  heading,
  subtitle,
  imageUrl,
  taxNote,
  ctas,
  givebutterAccountId,
  givebutterWidgetId,
} = Astro.props;

const acctId = givebutterAccountId || 'qGMyp9PcvINJwyvd';
const widgetId = givebutterWidgetId || 'g8MJdP';

const displayHeading = heading || 'Give Today. Create Lasting Impact.';
const displaySubtitle = subtitle || 'Your donation directly funds healing retreats, community care, and trauma-informed programs like Heads Up—supporting Israelis and Jewish individuals on their journey to recovery.';
const displayImage = imageUrl || '/images/hero/donate.jpg';
const displayTaxNote = taxNote || 'We are an official tax exempt organization with a 501(c)(3) classification. All donors can deduct contributions.';
const heroCtas = (ctas ?? []).filter((c) => c && c.label && c.url).slice(0, 2);
---

<section id="donate-hero" class="relative min-h-[85vh] overflow-hidden lg:min-h-[calc(100vh-var(--nav-height))]">
  <img src={displayImage} alt="Supporting healing through generous donations" class="absolute inset-0 h-full w-full object-cover" style={`object-position: ${imagePosition}`} width="1920" height="1080" loading="eager" />
  <div class="hero-overlay absolute inset-0"></div>

  <div class="relative z-10 mx-auto flex min-h-[85vh] max-w-[1200px] flex-col items-center gap-10 px-6 pt-32 pb-16 lg:min-h-[calc(100vh-var(--nav-height))] lg:flex-row lg:items-center lg:gap-16 lg:pt-24">
    <!-- Left: Text -->
    <div class="lg:w-1/2">
      <h1 class="font-heading text-[clamp(32px,5vw,48px)] font-medium leading-[1.1] text-white">
        {displayHeading}
      </h1>
      <p class="mt-6 font-body text-[clamp(15px,2vw,18px)] leading-relaxed text-white/85">
        {displaySubtitle}
      </p>
      <p class="mt-6 font-heading text-sm font-normal leading-relaxed text-white/75 italic">
        {displayTaxNote}
      </p>
      {heroCtas.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-3">
          {heroCtas.map((cta) => (
            <a
              href={cta.url}
              class:list={[
                'inline-block rounded-[100px] px-8 py-3 font-heading text-base font-medium transition-colors',
                cta.style === 'secondary'
                  ? 'border border-white/80 text-white hover:bg-white/10'
                  : 'bg-[#FAF8F5] text-primary hover:bg-white',
              ]}
            >
              {cta.label}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Right: Givebutter donation widget -->
    <!-- Note: Widget color/branding is set in the Givebutter dashboard (Campaign > Design). Platform fee mode (0% + donor tips, or 3% flat + Stripe) is also chosen per-campaign in the dashboard, not here. -->
    <div class="w-full max-w-[440px] lg:w-1/2">
      <script src={`https://widgets.givebutter.com/latest.umd.cjs?acct=${acctId}&p=other`} async is:inline></script>
      <givebutter-widget id={widgetId}></givebutter-widget>
      <script is:inline>
        (function () {
          var params = new URLSearchParams(window.location.search);
          var amount = params.get('amount');
          if (amount && /^\d+$/.test(amount)) {
            var widget = document.querySelector('givebutter-widget');
            if (widget) {
              widget.setAttribute('amount', amount);
            }
          }
        })();
      </script>
    </div>
  </div>
</section>
