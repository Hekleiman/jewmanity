---
import SubscribeForm from '../shared/SubscribeForm.astro';

interface Props {
  heading?: string;
  description?: string;
  emailPlaceholder?: string;
  buttonText?: string;
  footnote?: string;
  configurationPending?: string;
}

const {
  heading,
  description,
  emailPlaceholder = 'Enter your email',
  buttonText = 'Subscribe',
  footnote = 'You can unsubscribe at any time. Review our Privacy Policy.',
  configurationPending = 'Newsletter signup is being configured. Subscribe at launch.',
} = Astro.props;

const displayHeading = heading || 'Stay Connected';
const displayDescription = description || 'Receive updates on our programs, resources, and how your support is making a difference. We respect your privacy and will never share your information.';

const PRIVACY_LINK_TARGET = 'Privacy Policy';
const footnoteParts = footnote.split(PRIVACY_LINK_TARGET);
const footnoteBefore = footnoteParts[0];
const footnoteAfter = footnoteParts.length > 1 ? footnoteParts.slice(1).join(PRIVACY_LINK_TARGET) : '';
const hasPrivacyLink = footnoteParts.length > 1;
---

<section id="newsletter" class="bg-bg-section-alt py-16 md:py-20 lg:py-24" data-animate="fade-up">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="mb-10 text-center">
      <h2 class="font-heading text-[clamp(28px,4vw,36px)] font-medium leading-tight text-text-heading">
        {displayHeading}
      </h2>
      <p class="mx-auto mt-4 max-w-[600px] font-heading text-[clamp(18px,2.5vw,24px)] font-normal leading-relaxed text-text-body">
        {displayDescription}
      </p>
    </div>

    <SubscribeForm
      id="newsletter-email"
      variant="light"
      emailPlaceholder={emailPlaceholder}
      buttonText={buttonText}
      configurationPending={configurationPending}
      class="mx-auto"
    />

    <p class="mx-auto mt-4 max-w-[450px] text-center font-body text-xs text-text-muted">
      {hasPrivacyLink ? (
        <>
          {footnoteBefore}<a href="/privacy" class="text-primary hover:underline">Privacy Policy</a>{footnoteAfter}
        </>
      ) : (
        footnote
      )}
    </p>
  </div>
</section>
