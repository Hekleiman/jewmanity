---
interface Props {
  heading?: string;
  description?: string;
}

const { heading, description } = Astro.props;
const displayHeading = heading || 'Stay Connected';
const displayDescription = description || 'Receive updates on our programs, resources, and how your support is making a difference. We respect your privacy and will never share your information.';

const formAction = import.meta.env.PUBLIC_MAILCHIMP_FORM_ACTION;

let isConfigured = false;
let honeypotName = '';

if (formAction && formAction !== 'your_mailchimp_form_action_url') {
  try {
    const url = new URL(formAction);
    const userId = url.searchParams.get('u');
    const listId = url.searchParams.get('id');
    if (userId && listId) {
      isConfigured = true;
      honeypotName = `b_${userId}_${listId}`;
    }
  } catch {
    // Invalid URL, leave isConfigured false.
  }
}
---

<section id="newsletter" class="bg-bg-section-alt py-16 md:py-20 lg:py-24" data-animate="fade-up">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="mb-10 text-center">
      <h2 class="font-heading text-[clamp(28px,4vw,36px)] font-medium leading-tight text-text-heading">
        {displayHeading}
      </h2>
      <p class="mx-auto mt-4 max-w-[600px] font-heading text-[clamp(18px,2.5vw,24px)] font-normal leading-relaxed text-text-body">
        {displayDescription}
      </p>
    </div>

    {isConfigured ? (
    <form method="POST" action={formAction} target="_blank" class="mx-auto flex max-w-[450px]">
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        id="newsletter-email"
        type="email"
        name="EMAIL"
        required
        placeholder="Enter your email"
        class="min-w-0 flex-1 rounded-l-[100px] border border-r-0 border-border-card bg-white px-5 py-3 font-body text-base text-text-heading placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
      />
      <button
        type="submit"
        class="shrink-0 rounded-r-[100px] bg-primary px-6 py-3 font-heading text-sm font-medium text-white transition-colors hover:bg-primary-hover"
      >
        Subscribe
      </button>
      <div aria-hidden="true" style="position: absolute; left: -5000px;">
        <input type="text" name={honeypotName} tabindex="-1" value="" />
      </div>
    </form>
    ) : (
    <p class="mx-auto mt-4 max-w-[450px] text-center font-body text-sm text-text-muted">
      Newsletter signup is being configured. Subscribe at launch.
    </p>
    )}

    <p class="mx-auto mt-4 max-w-[450px] text-center font-body text-xs text-text-muted">
      You can unsubscribe at any time. Review our
      <a href="/privacy" class="text-primary hover:underline">Privacy Policy</a>.
    </p>
  </div>
</section>
