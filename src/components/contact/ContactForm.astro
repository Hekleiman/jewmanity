---
interface FormFieldOption {
  label: string;
  value?: string;
}
interface FormFieldConfig {
  name: string;
  label?: string;
  placeholder?: string;
  helperText?: string;
  type?: string;
  required?: boolean;
  options?: FormFieldOption[];
}
interface FormMessagesConfig {
  submitButton?: string;
  submittingButton?: string;
  success?: string;
  error?: string;
  configurationPending?: string;
}
interface Props {
  heading?: string;
  privacyNote?: string;
  formSection?: {
    fields?: FormFieldConfig[];
    messages?: FormMessagesConfig;
  };
}

const { heading, privacyNote, formSection } = Astro.props;
const displayHeading = heading || 'Contact Us';
const displayPrivacyNote = privacyNote || 'Your message will be kept private and treated with care.';

const formFields: FormFieldConfig[] = formSection?.fields || [];
function field(name: string, fallback: { label: string; placeholder?: string }) {
  const cms = formFields.find((f) => f.name === name);
  return {
    label: cms?.label || fallback.label,
    placeholder: cms?.placeholder || fallback.placeholder || '',
    options: cms?.options || [],
  };
}
const fFirstName = field('firstName', { label: 'First Name', placeholder: 'Enter your first name' });
const fLastName = field('lastName', { label: 'Last Name', placeholder: 'Enter your last name' });
const fEmail = field('email', { label: 'Email Address', placeholder: 'your@email.com' });
const fSubject = field('subject', { label: 'Subject', placeholder: 'Select a topic' });
const fMessage = field('message', { label: 'Message', placeholder: 'Write your message here...' });

const messages = formSection?.messages || {};
const submitText = messages.submitButton || 'Send Message';
const submittingText = messages.submittingButton || 'Sending...';
const successText = messages.success || 'Thank you! Your message has been sent.';
const errorText = messages.error || 'Something went wrong. Please try again.';
const configPendingText = messages.configurationPending
  || 'The contact form is being configured. Please email us at the address shown on this page or check back soon.';

const fallbackSubjectOptions: FormFieldOption[] = [
  { label: 'General Inquiry' },
  { label: 'Program Information' },
  { label: 'Volunteer Opportunities' },
  { label: 'Donation Questions' },
  { label: 'Mitzvah Project' },
  { label: 'Partnership' },
  { label: 'Other' },
];
const subjectOptions = fSubject.options.length > 0 ? fSubject.options : fallbackSubjectOptions;

const formId = import.meta.env.PUBLIC_FORMSPREE_CONTACT_ID;
const isConfigured = !!formId && formId !== 'your_formspree_form_id_for_contact_form';
const actionUrl = isConfigured ? `https://formspree.io/f/${formId}` : '';
---

<section id="contact-form" class="py-16 md:py-20 lg:py-24">
  <div class="mx-auto max-w-[700px] px-6">
    <h2 class="text-center font-heading text-[clamp(28px,4vw,36px)] font-medium leading-tight text-text-heading">
      {displayHeading}
    </h2>

    {isConfigured ? (
    <form
      id="contact-form-el"
      action={actionUrl}
      method="POST"
      class="mt-10 space-y-6"
    >

      <!-- Honeypot spam field -->
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div>
          <label for="firstName" class="mb-1.5 block font-body text-sm font-medium text-text-heading">
            {fFirstName.label}
          </label>
          <input
            type="text"
            id="firstName"
            name="firstName"
            required
            aria-required="true"
            placeholder={fFirstName.placeholder}
            class="w-full rounded-lg border border-[#DADADA] bg-white px-4 py-3 font-body text-sm text-text-heading placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
        </div>
        <div>
          <label for="lastName" class="mb-1.5 block font-body text-sm font-medium text-text-heading">
            {fLastName.label}
          </label>
          <input
            type="text"
            id="lastName"
            name="lastName"
            required
            aria-required="true"
            placeholder={fLastName.placeholder}
            class="w-full rounded-lg border border-[#DADADA] bg-white px-4 py-3 font-body text-sm text-text-heading placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div>
          <label for="email" class="mb-1.5 block font-body text-sm font-medium text-text-heading">
            {fEmail.label}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            aria-required="true"
            placeholder={fEmail.placeholder}
            class="w-full rounded-lg border border-[#DADADA] bg-white px-4 py-3 font-body text-sm text-text-heading placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
        </div>
        <div>
          <label for="subject" class="mb-1.5 block font-body text-sm font-medium text-text-heading">
            {fSubject.label}
          </label>
          <select
            id="subject"
            name="subject"
            required
            aria-required="true"
            class="w-full appearance-none rounded-lg border border-[#DADADA] bg-white px-4 py-3 font-body text-sm text-text-heading focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          >
            <option value="" disabled selected>{fSubject.placeholder}</option>
            {subjectOptions.map((opt) => (
              <option value={opt.value || opt.label}>{opt.label}</option>
            ))}
          </select>
        </div>
      </div>

      <div>
        <label for="message" class="mb-1.5 block font-body text-sm font-medium text-text-heading">
          {fMessage.label}
        </label>
        <textarea
          id="message"
          name="message"
          required
          aria-required="true"
          rows="5"
          placeholder={fMessage.placeholder}
          class="w-full resize-vertical rounded-lg border border-[#DADADA] bg-white px-4 py-3 font-body text-sm text-text-heading placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
        ></textarea>
      </div>

      <div class="text-center">
        <button
          type="submit"
          id="contact-submit-btn"
          data-submit-text={submitText}
          data-submitting-text={submittingText}
          class="inline-block rounded-[100px] bg-primary px-8 py-3 font-heading text-sm font-medium leading-6 text-white transition-colors hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60"
        >
          {submitText}
        </button>
      </div>

      <p class="text-center font-body text-sm text-text-muted">
        {displayPrivacyNote}
      </p>

      <!-- Success message -->
      <div
        id="contact-success"
        class="hidden rounded-lg bg-green-50 border border-green-200 p-4 text-center font-body text-sm text-green-800"
        role="alert"
      >
        {successText}
      </div>

      <!-- Error message -->
      <div
        id="contact-error"
        class="hidden rounded-lg bg-red-50 border border-red-200 p-4 text-center font-body text-sm text-red-800"
        role="alert"
      >
        {errorText}
      </div>
    </form>
    ) : (
    <p class="mt-10 text-center font-body text-sm text-text-muted">
      {configPendingText}
    </p>
    )}
  </div>
</section>

<script>
  const form = document.getElementById('contact-form-el') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
  const successMsg = document.getElementById('contact-success') as HTMLDivElement | null;
  const errorMsg = document.getElementById('contact-error') as HTMLDivElement | null;

  if (form && submitBtn && successMsg && errorMsg) {
    const submitText = submitBtn.dataset.submitText || 'Send Message';
    const submittingText = submitBtn.dataset.submittingText || 'Sending...';

    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();

      submitBtn.disabled = true;
      submitBtn.textContent = submittingText;
      successMsg.classList.add('hidden');
      errorMsg.classList.add('hidden');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          successMsg.classList.remove('hidden');
          form.reset();
        } else {
          errorMsg.classList.remove('hidden');
        }
      } catch {
        errorMsg.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = submitText;
      }
    });
  }
</script>
