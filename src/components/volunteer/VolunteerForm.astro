---
interface FormFieldOption {
  label: string;
  value?: string;
}
interface FormFieldConfig {
  name: string;
  label?: string;
  placeholder?: string;
  helperText?: string;
  type?: string;
  required?: boolean;
  options?: FormFieldOption[];
}
interface FormMessagesConfig {
  submitButton?: string;
  submittingButton?: string;
  success?: string;
  error?: string;
  configurationPending?: string;
}
interface Props {
  heading?: string;
  subtitle?: string;
  privacyNote?: string;
  formSection?: {
    fields?: FormFieldConfig[];
    emailSubject?: string;
    messages?: FormMessagesConfig;
  };
}

const { heading, subtitle, privacyNote, formSection } = Astro.props;
const displayHeading = heading || 'Volunteer Application';
const displaySubtitle = subtitle || "Fill out the form below and we'll be in touch to find the right fit for you.";
const displayPrivacyNote = privacyNote || 'Your information will be kept confidential and used only for volunteer coordination.';

const formFields: FormFieldConfig[] = formSection?.fields || [];
function field(name: string, fallback: { label: string; placeholder?: string }) {
  const cms = formFields.find((f) => f.name === name);
  return {
    label: cms?.label || fallback.label,
    placeholder: cms?.placeholder || fallback.placeholder || '',
    options: cms?.options || [],
  };
}
const fFirstName = field('firstName', { label: 'First Name', placeholder: 'Enter your first name' });
const fLastName = field('lastName', { label: 'Last Name', placeholder: 'Enter your last name' });
const fEmail = field('email', { label: 'Email Address', placeholder: 'your@email.com' });
const fPhone = field('phone', { label: 'Phone Number', placeholder: '(555) 123-4567' });
const fLocation = field('location', { label: 'City / Location', placeholder: 'e.g. San Diego, CA' });
const fReferral = field('referral', { label: 'How did you hear about us?', placeholder: 'Select an option' });
const fInterests = field('interests', { label: 'Areas of Interest' });
const fAbout = field('about', {
  label: 'Tell us about yourself',
  placeholder: "Share anything you'd like us to know, your background, availability, or what drew you to volunteer.",
});
const fAvailability = field('availability', { label: 'Availability', placeholder: 'Select your availability' });

const fallbackReferralOptions: FormFieldOption[] = [
  { label: 'Social Media' },
  { label: 'Friend or Family' },
  { label: 'Synagogue or Community Org' },
  { label: 'Web Search' },
  { label: 'Event' },
  { label: 'Other' },
];
const fallbackInterestOptions: FormFieldOption[] = [
  { label: 'Preparing and Serving Meals' },
  { label: 'Hosting Dinners and Gatherings' },
  { label: 'Day-to-Day Support' },
  { label: 'Other' },
];
const fallbackAvailabilityOptions: FormFieldOption[] = [
  { label: 'A few hours per retreat' },
  { label: 'Full retreat (5-7 days)' },
  { label: 'Ongoing/regular basis' },
  { label: "Flexible, tell me what's needed", value: 'Flexible' },
];
const referralOptions = fReferral.options.length > 0 ? fReferral.options : fallbackReferralOptions;
const interestOptions = fInterests.options.length > 0 ? fInterests.options : fallbackInterestOptions;
const availabilityOptions = fAvailability.options.length > 0 ? fAvailability.options : fallbackAvailabilityOptions;

const messages = formSection?.messages || {};
const submitText = messages.submitButton || 'Submit Volunteer Application';
const submittingText = messages.submittingButton || 'Submitting...';
const successText = messages.success || "Thank you for your application! We'll be in touch soon.";
const errorText = messages.error || 'Something went wrong. Please try again.';
const configPendingText = messages.configurationPending
  || 'The volunteer application form is being configured. Please check back soon or reach out via the contact page.';

const emailSubject = formSection?.emailSubject || 'New Volunteer Application';

const formId = import.meta.env.PUBLIC_FORMSPREE_VOLUNTEER_ID;
const isConfigured = !!formId && formId !== 'your_formspree_form_id_for_volunteer_form';
const actionUrl = isConfigured ? `https://formspree.io/f/${formId}` : '';
---

<section id="volunteer-form" class="bg-bg-alt py-16 md:py-20 lg:py-24">
  <div class="mx-auto max-w-[700px] px-6">
    <h2 class="text-center font-heading text-[clamp(28px,4vw,36px)] font-medium leading-tight text-text-heading">
      {displayHeading}
    </h2>
    <p class="mx-auto mt-4 max-w-[550px] text-center font-heading text-[clamp(16px,2.2vw,20px)] font-normal leading-relaxed text-text-body">
      {displaySubtitle}
    </p>

    {isConfigured ? (
    <form
      id="volunteer-form-el"
      action={actionUrl}
      method="POST"
      class="mt-10 space-y-6"
    >
      <input type="hidden" name="_subject" value={emailSubject} />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

      <!-- Row 1: Name -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div>
          <label for="vol-firstName" class="mb-1.5 block font-body text-sm font-medium text-text-heading">
            {fFirstName.label} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="vol-firstName"
            name="firstName"
            required
            aria-required="true"
            placeholder={fFirstName.placeholder}
            class="w-full rounded-lg border border-[#DADADA] bg-white px-4 py-3 font-body text-sm text-text-heading placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
        </div>
        <div>
          <label for="vol-lastName" class="mb-1.5 block font-body text-sm font-medium text-text-heading">
            {fLastName.label} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="vol-lastName"
            name="lastName"
            required
            aria-required="true"
            placeholder={fLastName.placeholder}
            class="w-full rounded-lg border border-[#DADADA] bg-white px-4 py-3 font-body text-sm text-text-heading placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
        </div>
      </div>

      <!-- Row 2: Email + Phone -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div>
          <label for="vol-email" class="mb-1.5 block font-body text-sm font-medium text-text-heading">
            {fEmail.label} <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="vol-email"
            name="email"
            required
            aria-required="true"
            placeholder={fEmail.placeholder}
            class="w-full rounded-lg border border-[#DADADA] bg-white px-4 py-3 font-body text-sm text-text-heading placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
        </div>
        <div>
          <label for="vol-phone" class="mb-1.5 block font-body text-sm font-medium text-text-heading">
            {fPhone.label}
          </label>
          <input
            type="tel"
            id="vol-phone"
            name="phone"
            placeholder={fPhone.placeholder}
            class="w-full rounded-lg border border-[#DADADA] bg-white px-4 py-3 font-body text-sm text-text-heading placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
        </div>
      </div>

      <!-- Row 3: Location + How did you hear -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div>
          <label for="vol-location" class="mb-1.5 block font-body text-sm font-medium text-text-heading">
            {fLocation.label}
          </label>
          <input
            type="text"
            id="vol-location"
            name="location"
            placeholder={fLocation.placeholder}
            class="w-full rounded-lg border border-[#DADADA] bg-white px-4 py-3 font-body text-sm text-text-heading placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
        </div>
        <div>
          <label for="vol-referral" class="mb-1.5 block font-body text-sm font-medium text-text-heading">
            {fReferral.label}
          </label>
          <select
            id="vol-referral"
            name="referral"
            class="w-full appearance-none rounded-lg border border-[#DADADA] bg-white px-4 py-3 font-body text-sm text-text-heading focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          >
            <option value="" disabled selected>{fReferral.placeholder}</option>
            {referralOptions.map((opt) => (
              <option value={opt.value || opt.label}>{opt.label}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Row 4: Areas of Interest -->
      <fieldset>
        <legend class="mb-3 font-body text-sm font-medium text-text-heading">
          {fInterests.label}
        </legend>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {interestOptions.map((opt) => (
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-[#DADADA] bg-white px-4 py-3 transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
              <input
                type="checkbox"
                name="interests"
                value={opt.value || opt.label}
                class="h-4 w-4 shrink-0 rounded border-[#DADADA] accent-primary"
              />
              <span class="font-body text-sm text-text-heading">{opt.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <!-- Row 5: About yourself -->
      <div>
        <label for="vol-about" class="mb-1.5 block font-body text-sm font-medium text-text-heading">
          {fAbout.label}
        </label>
        <textarea
          id="vol-about"
          name="about"
          rows="4"
          placeholder={fAbout.placeholder}
          class="w-full resize-vertical rounded-lg border border-[#DADADA] bg-white px-4 py-3 font-body text-sm text-text-heading placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
        ></textarea>
      </div>

      <!-- Row 6: Availability -->
      <div>
        <label for="vol-availability" class="mb-1.5 block font-body text-sm font-medium text-text-heading">
          {fAvailability.label}
        </label>
        <select
          id="vol-availability"
          name="availability"
          class="w-full appearance-none rounded-lg border border-[#DADADA] bg-white px-4 py-3 font-body text-sm text-text-heading focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
        >
          <option value="" disabled selected>{fAvailability.placeholder}</option>
          {availabilityOptions.map((opt) => (
            <option value={opt.value || opt.label}>{opt.label}</option>
          ))}
        </select>
      </div>

      <!-- Submit -->
      <div class="text-center">
        <button
          type="submit"
          id="volunteer-submit-btn"
          data-submit-text={submitText}
          data-submitting-text={submittingText}
          class="inline-block rounded-[100px] bg-primary px-8 py-3 font-heading text-sm font-medium leading-6 text-white transition-colors hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60"
        >
          {submitText}
        </button>
      </div>

      <p class="text-center font-body text-sm text-text-muted">
        {displayPrivacyNote}
      </p>

      <!-- Success message -->
      <div
        id="volunteer-success"
        class="hidden rounded-lg border border-green-200 bg-green-50 p-4 text-center font-body text-sm text-green-800"
        role="alert"
      >
        {successText}
      </div>

      <!-- Error message -->
      <div
        id="volunteer-error"
        class="hidden rounded-lg border border-red-200 bg-red-50 p-4 text-center font-body text-sm text-red-800"
        role="alert"
      >
        {errorText}
      </div>
    </form>
    ) : (
    <p class="mt-10 text-center font-body text-sm text-text-muted">
      {configPendingText}
    </p>
    )}
  </div>
</section>

<script>
  const form = document.getElementById('volunteer-form-el') as HTMLFormElement | null;
  const submitBtn = document.getElementById('volunteer-submit-btn') as HTMLButtonElement | null;
  const successMsg = document.getElementById('volunteer-success') as HTMLDivElement | null;
  const errorMsg = document.getElementById('volunteer-error') as HTMLDivElement | null;

  if (form && submitBtn && successMsg && errorMsg) {
    const submitText = submitBtn.dataset.submitText || 'Submit Volunteer Application';
    const submittingText = submitBtn.dataset.submittingText || 'Submitting...';

    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();

      submitBtn.disabled = true;
      submitBtn.textContent = submittingText;
      successMsg.classList.add('hidden');
      errorMsg.classList.add('hidden');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          successMsg.classList.remove('hidden');
          form.reset();
        } else {
          errorMsg.classList.remove('hidden');
        }
      } catch {
        errorMsg.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = submitText;
      }
    });
  }
</script>
