---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/shared/HeroSection.astro';
import RetreatGrid from '../../components/programs/RetreatGrid.astro';
import TestimonialCarousel from '../../components/shared/TestimonialCarousel.astro';
import CTASection from '../../components/shared/CTASection.astro';
import { getProgramsPastRetreatsPage, getRetreats, getTestimonials, urlFor, urlForCropped } from '../../lib/sanity';

let cms: Record<string, any> | null = null;
try {
  cms = await getProgramsPastRetreatsPage();
} catch (e) {
  console.warn('Sanity fetch failed for programsPastRetreatsPage, using hardcoded fallbacks');
}

const heroBg = cms?.hero?.backgroundImage
  ? urlFor(cms.hero.backgroundImage).width(1920).quality(80).url()
  : '/images/hero/past-retreats.jpg';

const ctaPrimary = cms?.ctaPrimaryButton?.text && cms?.ctaPrimaryButton?.href
  ? cms.ctaPrimaryButton
  : { text: 'Learn More About Heads Up', href: '/programs/heads-up' };

let cmsRetreats: { title: string; location: string; description: string; href: string; image?: string }[] = [];
try {
  const raw = await getRetreats();
  cmsRetreats = raw.map((r: any) => ({
    title: r.title,
    location: r.location || '',
    description: r.subtitle || '',
    href: `/programs/${r.slug?.current || ''}`,
    image: r.coverImage ? urlFor(r.coverImage).width(600).url() : undefined,
  }));
} catch (e) {
  console.warn('Sanity fetch failed for retreats, using fallback content');
}

let cmsTestimonials: { quote: string; author: string; context: string; imageUrl?: string }[] = [];
try {
  const raw = await getTestimonials('headsup');
  cmsTestimonials = raw.map((t: any) => ({
    quote: t.excerpt || t.quote,
    author: t.authorName || '',
    context: t.authorRole || '',
    imageUrl: t.imageUrl
      ? t.imageUrl
      : t.authorImage
        ? urlForCropped(t.authorImage, 224, 224).url()
        : undefined,
  }));
} catch (e) {
  console.warn('Sanity fetch failed for testimonials, using fallback content');
}
---
<Layout title="Past Retreats | Jewmanity" description="Stories of courage, connection, and healing from Jewmanity's Heads Up retreat program.">
  <HeroSection
    heading={cms?.hero?.heading ?? 'Past Retreats'}
    subtitle={cms?.hero?.subtitle ?? 'Jewmanity creates safe, restorative spaces where Israeli soldiers and their loved ones find healing, connection, and renewed hope.'}
    backgroundImage={heroBg}
    imagePosition="center 20%"
  />
  <RetreatGrid
    retreats={cmsRetreats.length > 0 ? cmsRetreats : undefined}
    heading={cms?.gridHeading}
    subtitle={cms?.gridSubtitle}
  />
  <TestimonialCarousel
    heading={cms?.testimonialsHeading ?? 'What Our Attendees Say'}
    subtitle={cms?.testimonialsSubtitle ?? 'Honest reflections from those who found healing, connection, and renewed strength through Heads Up.'}
    testimonials={cmsTestimonials.length > 0 ? cmsTestimonials : [
      {
        quote: 'After October 7th, I lost my faith, especially in myself. Through Jewmanity, I spent a month in the U.S. healing and being supported by professional care. This journey helped me believe in myself again.',
        author: 'Matan Balahsan',
        context: 'Heads Up Participant',
      },
      {
        quote: "I give them my heart, my time, and my presence, and somehow I receive so much back. The joy of giving to them feels endless, and I'm grateful to be part of their journey.",
        author: 'Dahlia',
        context: 'Volunteer',
      },
    ]}
  />
  <CTASection
    heading={cms?.ctaHeading ?? 'Healing Happens Together'}
    subtitle={cms?.ctaSubtitle ?? 'These retreats continue to create space for healing, connection, and transformation. Your support helps us expand our reach and serve more individuals on their journey toward recovery.'}
    primaryCta={ctaPrimary}
  />
</Layout>
